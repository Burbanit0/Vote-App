# BuildKit reads this (<dockerfile>.dockerignore) for the frontend build.
# Patterns are relative to the build context root (the repo root).
.git
ci-local
flask_voter_app
**/node_modules
voter-app/build
voter-app/coverage
voter-app/playwright-report
voter-app/test-results
voter-app/.vite
**/__pycache__
**/*.pyc
