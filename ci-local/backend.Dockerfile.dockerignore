# BuildKit reads this (<dockerfile>.dockerignore) for the backend build.
# Patterns are relative to the build context root (the repo root).
.git
ci-local
voter-app
**/node_modules
**/__pycache__
**/*.pyc
fast_api_voter/.venv
fast_api_voter/.pytest_cache
fast_api_voter/.mypy_cache
fast_api_voter/htmlcov
fast_api_voter/coverage.xml
fast_api_voter/.coverage
**/*.db
**/*.sqlite3
