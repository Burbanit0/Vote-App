# ── Vote Lab — Backend environment variables ──────────────────────────────────
# Copy this file to .env (never commit .env)
#   cp fast_api_voter/.env.example fast_api_voter/.env

# Flask environment: development | testing | production
FLASK_ENV=development

# Secret keys — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_SECRET
JWT_SECRET_KEY=REPLACE_WITH_DIFFERENT_STRONG_RANDOM_SECRET

# Database — matches docker-compose.yml defaults for local dev
DATABASE_URL=postgresql://myuser:mypassword@db:5432/mydatabase

# Redis — matches docker-compose.yml defaults for local dev
REDIS_URL=redis://redis:6379

# CORS — comma-separated list of allowed frontend origins
# Local dev:
CORS_ORIGINS=http://localhost:3000
# Production example:
# CORS_ORIGINS=https://votelab.vercel.app,https://votelab.app

# Debug (true only in development — never in production)
DEBUG=true
