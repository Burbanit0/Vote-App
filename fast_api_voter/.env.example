# ── Vote Lab — Backend environment variables ──────────────────────────────────
# Copy this file to .env (never commit .env)
#   cp fast_api_voter/.env.example fast_api_voter/.env
#
# The backend is stateless (no SQL DB, no auth). Redis is the only backing
# service, used purely as a compute cache for the voting engine.

# Environment: development | testing | production (APP_ENV, FLASK_ENV also read)
APP_ENV=development

# Redis — matches docker-compose.yml defaults for local dev
REDIS_URL=redis://redis:6379

# CORS — comma-separated list of allowed frontend origins
# Local dev:
CORS_ORIGINS=http://localhost:3000
# Production example:
# CORS_ORIGINS=https://votelab.vercel.app,https://votelab.app

# Logging level
LOG_LEVEL=INFO

# Error tracking (Lot 10.1) — self-hosted GlitchTip, never Sentry SaaS. Empty
# (default) disables it entirely. Bring up docker-compose.observability.yml,
# create a project through its UI, and paste that project's DSN here.
GLITCHTIP_DSN=

# Metrics — optional shared secret for GET /api/v2/metrics. Leave unset (the
# default) to keep metrics unauthenticated, fine for local dev / this app's
# no-auth-anywhere-else posture. Set it on a production deploy to require
# `Authorization: Bearer <token>`:
# METRICS_AUTH_TOKEN=

# OpenTelemetry tracing (Lot 10.2) — empty (default) disables tracing entirely.
# Base OTLP/HTTP collector URL, no trailing path (api/core/tracing.py appends
# /v1/traces). Point it at the Jaeger all-in-one from
# docker-compose.observability-tracing.yml for local dev:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
