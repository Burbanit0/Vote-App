# engine-strict: turns the `engines` field in package.json into a hard
# `npm install`/`npm ci` failure instead of a warning that's easy to miss.
# Added 2026-09-14 after a real, reproduced crash: size-limit@13 raised its
# own Node floor to `^22.18.0 || ^24.0.0 || >=26.0.0` and started using a
# node:fs/promises export that doesn't exist before ~22.13 -- on an older
# Node, `npm install` used to succeed with just an EBADENGINE warning,
# and `npm run build` crashed confusingly much later with no obvious link
# back to "wrong Node version". Fail fast, at install time, instead.
engine-strict=true
