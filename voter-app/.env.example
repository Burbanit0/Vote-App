# ── Vote Lab — Frontend environment variables ─────────────────────────────────
# Copy this file to .env.local (never commit .env.local)
#   cp voter-app/.env.example voter-app/.env.local

# Backend API URL
# Local dev (docker-compose exposes FastAPI on port 4434):
VITE_API_URL=http://localhost:4434
# Production example:
# VITE_API_URL=https://api.votelab.app

# ── Analytics (Umami, self-hosted — see analytics/README.md) ─────────────────
# Anonymous, cookie-less usage measurement. Leave BOTH unset to disable
# entirely (dev builds and repo forks send nothing). Only read in production
# builds (`npm run build`).
# VITE_UMAMI_SRC=https://analytics.example.com/script.js
# VITE_UMAMI_WEBSITE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
