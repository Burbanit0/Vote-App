# ── Vote Lab — Frontend environment variables ─────────────────────────────────
# Copy this file to .env.local (never commit .env.local)
#   cp voter-app/.env.example voter-app/.env.local

# Backend API URL
# Local dev (docker-compose exposes FastAPI on port 4434):
VITE_API_URL=http://localhost:4434
# Production example:
# VITE_API_URL=https://api.votelab.app

# Google OAuth — set this to enable "Sign in with Google"
# Get a client ID from https://console.cloud.google.com/apis/credentials
# VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
