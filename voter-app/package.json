{
  "name": "voter-app",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@testing-library/dom": "^10.4.0",
    "@types/d3": "^7.4.3",
    "@types/d3-delaunay": "^6.0.4",
    "@types/node": "^26.4.1",
    "@typescript-eslint/parser": "^8.69.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "d3-delaunay": "^6.0.4",
    "i18next": "^26.4.1",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.39.0",
    "openapi-fetch": "^0.17.0",
    "openapi-react-query": "^0.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.13",
    "react-joyride": "^3.2.0",
    "react-router": "^8.3.1",
    "recharts": "^3.10.1",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.15"
  },
  "scripts": {
    "start": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prettier-format": "prettier --config .prettierrc 'src/**/*.ts' --write",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:sonarjs": "eslint -c eslint.sonarjs.config.js . --ext .js,.jsx,.ts,.tsx",
    "knip": "knip",
    "madge:circular": "madge --circular --extensions ts,tsx src",
    "depcruise": "depcruise --config .dependency-cruiser.json src",
    "type-coverage": "type-coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "test:visual": "playwright test --config=playwright.visual.config.ts",
    "test:visual:docker": "bash scripts/test-visual-docker.sh",
    "test:visual:docker:update": "bash scripts/test-visual-docker.sh --update-snapshots",
    "test:mutation": "stryker run",
    "gen:api": "openapi-typescript ../fast_api_voter/openapi.gen.json -o src/api/types.gen.ts",
    "gen:pseudo-locale": "jiti scripts/gen-pseudo-locale.ts"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "fast-check": "^4.9.0",
    "globals": "^17.12.0",
    "i18next-cli": "^1.0.0",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "knip": "^6.34.0",
    "license-checker-rseidelsohn": "^4.4.2",
    "madge": "^8.0.0",
    "nyc": "^18.0.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.0",
    "type-coverage": "^2.30.1",
    "typescript": "^5.8.3",
    "vite": "^8.2.2",
    "vite-plugin-istanbul": "^9.0.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.7",
    "workbox-window": "^7.4.1"
  },
  "overrides": {
    "typescript": "^5.8.3",
    "ws": "^8.21.0",
    "js-yaml": "^4.3.2",
    "qs": "^6.16.0",
    "fast-uri": "^3.1.7",
    "@humanfs/node": "^0.16.8",
    "glob": "^11.1.0"
  },
  "license": "MIT"
}
